# Reference only: this service never reads .env files.
# Pass these variables through the MCP client's env configuration.
EMAIL_USERNAME=you@example.com
EMAIL_PASSWORD=replace-with-password-or-app-password
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_TLS=ssl
EMAIL_POP3_HOST=pop.example.com
EMAIL_POP3_PORT=995
EMAIL_POP3_TLS=ssl
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_TLS=starttls
EMAIL_READ_PROTOCOL=imap
EMAIL_READ_ONLY=false
# EMAIL_FROM=Your Name <you@example.com>
# EMAIL_ATTACHMENT_DIR=F:\Email-MCP\.email-mcp\attachments
# EMAIL_TIMEOUT=30
# EMAIL_TLS_CA_FILE=C:\certificates\mail-ca.pem
# EMAIL_AUTH_TYPE=oauth2
# EMAIL_ACCESS_TOKEN=replace-with-access-token
